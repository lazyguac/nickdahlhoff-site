---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const fantasyJoes = allProjects.find(p => p.id === 'fantasy-joes');

// "Things I've made" is an explicit ordered list, not a status filter. Fantasy Joes has its own
// band above; ai-consulting is retired and noindexed. Copy for each card lives in the project's
// frontmatter (cardBlurb / stage / cardImage), approved in design/redesign-2026-09/copy.md.
const madeSlugs = [
  'all-language-resources',
  'hometown-coloring-book',
  'recess',
  'aura-finance',
  'alpaca-college',
  'manga-method',
  'teaching',
  'poker',
];
const made = madeSlugs
  .map(slug => allProjects.find(p => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const posts = (await getCollection('writing'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const projectTitle = (slug?: string) =>
  slug === undefined ? 'This site' : (allProjects.find(p => p.id === slug)?.data.title ?? slug);

function postDate(d: Date): string {
  const mm = String(d.getUTCMonth() + 1).padStart(2, '0');
  const dd = String(d.getUTCDate()).padStart(2, '0');
  const yy = String(d.getUTCFullYear()).slice(-2);
  return `${mm}.${dd}.${yy}`;
}

function meta(p: (typeof made)[number]): string {
  return p.data.stage ? `${p.data.year} · ${p.data.stage}` : p.data.year;
}
---

<BaseLayout title="Nick Dahlhoff">
  <div class="container">

    <!-- Hero -->
    <section class="hero">
      <div class="hero-text">
        <span class="mono kicker">The whole team on my own products</span>
        <h1>Nick Dahlhoff</h1>
        <p class="hero-lead">For the last few years I've been the whole team on my own products. With AI I work across the product, the engineering, and the growth at the same time. Before AI, I built a language-learning review site to 100,000 monthly readers and a six-person team, and sold it for about $960,000.</p>
        <div class="hero-actions">
          <a href="mailto:ndahlhoff10@gmail.com" class="btn">Email me</a>
          <span class="hero-note">Looking for a team that needs a do-everything builder · West Michigan · open to relocating in the US or working remote</span>
        </div>
      </div>
      <div class="portrait">
        <img src="/images/nick-headshot-640.jpg" alt="Illustrated portrait of Nick Dahlhoff" width="320" height="320" />
      </div>
    </section>

    <!-- Fantasy Joes -->
    {fantasyJoes && (
      <section class="latest">
        <div class="latest-head">
          <div class="latest-text">
            <span class="mono kicker">Latest · fantasyjoes.gg</span>
            <h2>Fantasy Joes</h2>
            <p>A fantasy football ranking game. Six players at a time, you pick the three you'd draft first, in order, and your rankings build themselves in the background. Then you can play those rankings for money, against other people, not the house. I built all of it, including the growth side: a Discord version of the game, programmatic SEO pages, ad tests, short-form video.</p>
          </div>
          <a href={`/projects/${fantasyJoes.id}`} class="text-link">Read the case study &rarr;</a>
        </div>
        <a href={`/projects/${fantasyJoes.id}`} class="frame latest-shot">
          <img src="/images/fantasy-joes/fj-six3-desktop.jpg" alt="Fantasy Joes: six player cards, pick your top three in order" width="1440" height="900" />
        </a>
      </section>
    )}

    <!-- Things I've made -->
    <section class="made" id="made">
      <div class="section-head">
        <h2>Things I've made</h2>
        <span class="mono section-note">One exit and a lot of building · 2012 &rarr; 2026</span>
      </div>
      <div class="made-grid">
        {made.map(p => (
          <a href={`/projects/${p.id}`} class="poster">
            {p.data.cardImage ? (
              <img src={p.data.cardImage} alt="" class="poster-img" loading="lazy" />
            ) : p.id === 'teaching' ? (
              <div class="poster-tile tile-beijing">
                <span class="tile-big">北京</span>
                <span class="tile-note">Grades 1–3, classes of 40, no curriculum for the foreign teacher.</span>
              </div>
            ) : p.id === 'poker' ? (
              <div class="poster-tile tile-poker">
                <span class="tile-spade">&#9824;</span>
              </div>
            ) : (
              <div class="poster-tile"></div>
            )}
            <div class="poster-body">
              <span class="poster-title">{p.data.title}</span>
              <span class="mono poster-meta">{meta(p)}</span>
              <span class="poster-desc">{p.data.cardBlurb ?? p.data.tagline}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Updates -->
    {posts.length > 0 && (
      <section class="updates">
        <div class="section-head updates-head">
          <div>
            <h2>Updates</h2>
            <p class="updates-sub">A build log. When something real ships, it gets a dated entry here and on its project's page.</p>
          </div>
          <a href="/writing" class="mono updates-all">Browse all &rarr;</a>
        </div>
        <div class="updates-list">
          {posts.map(post => (
            <a href={`/writing/${post.id}`} class="update-row">
              <span class="mono update-date">{postDate(post.data.date)}</span>
              <span class:list={['mono', 'update-project', { site: !post.data.project }]}>{projectTitle(post.data.project)}</span>
              <span class="update-title">{post.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</BaseLayout>

<style>
  .kicker {
    color: var(--color-accent);
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 80px;
    align-items: center;
    padding: 88px 0 72px;
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .hero-lead {
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-text-body);
    max-width: 720px;
  }
  .hero-actions {
    display: flex;
    gap: 20px;
    align-items: center;
    padding-top: 4px;
  }
  .hero-note {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .portrait {
    width: 320px;
    height: 320px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
    transform: rotate(-2deg);
    background: #EFE7D9;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Latest: Fantasy Joes */
  .latest {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 40px 0 56px;
    border-top: 1px solid var(--color-line);
  }
  .latest-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 40px;
  }
  .latest-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .latest-text h2 {
    font-size: 48px;
    line-height: 1;
  }
  .latest-text p {
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-soft);
    max-width: 760px;
  }
  .latest-shot {
    display: block;
  }
  .latest-shot:hover {
    text-decoration: none;
  }

  /* Things I've made */
  .made {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: 40px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
  }
  .section-note {
    color: var(--color-text-muted);
    letter-spacing: 0.12em;
  }
  .made-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }
  .poster {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .poster:hover {
    text-decoration: none;
    color: inherit;
    transform: translateY(-2px);
    border-color: var(--color-line-strong);
  }
  .poster-img,
  .poster-tile {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    display: block;
    background: var(--color-surface-2);
  }
  .poster-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px;
  }
  .tile-beijing {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 8px;
  }
  .tile-big {
    font-family: var(--font-display);
    font-size: 64px;
    font-weight: 800;
    line-height: 1;
    color: var(--color-text-display);
  }
  .tile-note {
    font-size: 18px;
    font-style: italic;
    line-height: 1.3;
    color: var(--color-text-soft);
  }
  .tile-poker {
    background: var(--color-paper);
  }
  .tile-spade {
    font-family: var(--font-display);
    font-size: 150px;
    font-weight: 800;
    line-height: 1;
    color: var(--color-bg);
  }
  .poster-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 20px;
    align-items: start;
    padding: 18px 22px 22px;
  }
  .poster-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.05;
    color: var(--color-text-display);
    letter-spacing: -0.01em;
  }
  .poster-meta {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    white-space: nowrap;
    padding-top: 6px;
  }
  .poster-desc {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-soft);
    margin-top: 8px;
    grid-column: 1 / -1;
  }

  /* Updates */
  .updates {
    display: flex;
    flex-direction: column;
    padding-top: 72px;
  }
  .updates-head {
    align-items: flex-end;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-text-display);
  }
  .updates-sub {
    font-size: 15px;
    color: var(--color-text-soft);
    max-width: 640px;
    margin-top: 6px;
  }
  .updates-all {
    letter-spacing: 0.12em;
    padding-bottom: 4px;
  }
  .update-row {
    display: grid;
    grid-template-columns: 90px 150px minmax(0, 1fr);
    column-gap: 24px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line);
    color: inherit;
  }
  .update-row:last-child {
    border-bottom: none;
  }
  .update-row:hover {
    text-decoration: none;
    color: inherit;
  }
  .update-row:hover .update-title {
    color: var(--color-accent);
  }
  .update-date {
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    text-transform: none;
  }
  .update-project {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }
  .update-project.site {
    color: var(--color-text-muted);
  }
  .update-title {
    font-size: 18px;
    font-weight: 500;
    color: var(--color-text);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding: 40px 0 40px;
    }
    .portrait {
      width: 160px;
      height: 160px;
      order: -1;
    }
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .latest-head {
      grid-template-columns: minmax(0, 1fr);
    }
    .latest-text h2 {
      font-size: 36px;
    }
    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    .made-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .poster-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .poster-meta {
      white-space: normal;
      padding-top: 4px;
    }
    .tile-big {
      font-size: 48px;
    }
    .tile-spade {
      font-size: 110px;
    }
    .update-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 4px;
    }
  }
</style>
