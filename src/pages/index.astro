---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

const fantasyJoes = allProjects.find(p => p.id === 'fantasy-joes');
const alr = allProjects.find(p => p.id === 'all-language-resources');

// The winding-road timeline is an explicit ordered slug list, not a status filter — the timeline
// mixes current/featured/archive projects by specific narrative slot (poker/Latin America →
// teaching → ALR exit → Aura/DeFi → Fantasy Joes now), which a status-based filter can't produce
// since it would miss Fantasy Joes (current) and ALR (featured). See spec §2.3 point 3 / risk #3.
const timelineSlugs = ['aura-finance', 'hometown-coloring-book', 'recess', 'alpaca-college', 'manga-method', 'teaching', 'poker'];
const timelineProjects = timelineSlugs
  .map(slug => allProjects.find(p => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const writingPosts = (await getCollection('writing'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

function shortenYear(yr: string): string {
  return yr
    .replace(/(\d{2})(\d{2})–(\d{2})(\d{2})/g, (_, c1, y1, c2, y2) =>
      c1 === c2 ? `${c1}${y1}–${y2}` : `${c1}${y1}–${c2}${y2}`)
    .replace(/(\d{4}),\s*(\d{2})(\d{2})/g, (_, first, c2, y2) =>
      `${first}, ${y2}`)
    .replace(/–present/, '–');
}

function formatPostDate(d: Date): string {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout
  title="Nick Dahlhoff"
  description="With AI, Nick Dahlhoff plays product manager, engineer, and growth marketer at once — building whole products and getting them users. Last company sold for $960,000."
>
  <div class="page">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-left">
        <h1>Nick Dahlhoff</h1>
        <p class="hero-sub">With AI, I play the role of product manager, engineer, and growth marketer at the same time — I decide what's worth building, then build it and get it users. My last company sold for $960,000.</p>
      </div>
      <div class="hero-right">
        <a href="mailto:ndahlhoff10@gmail.com" class="looking-for-link">Looking for a team that needs a do-everything builder &rarr;</a>
        <span class="hero-location">West Michigan &middot; open to relocating in the US or working remote</span>
      </div>
    </section>

    <!-- Featured cards: Fantasy Joes + Writing -->
    <section class="current-grid">
      {fantasyJoes && (
        <a href={`/projects/${fantasyJoes.id}`} class="current-card">
          <div class="current-header">
            <h2 class="current-title">Fantasy Joes</h2>
            <span class="current-badge">Live</span>
          </div>
          <p class="current-tagline">A fantasy-football ranking game where you build your rankings by picking players head-to-head, one duel at a time. I designed and built the whole thing myself with Claude Code.</p>
        </a>
      )}
      <a href="/writing" class="current-card">
        <div class="current-header">
          <h2 class="current-title">Writing</h2>
          <span class="current-badge">Essays</span>
        </div>
        <p class="current-tagline">Build-log essays on shipping real products with AI: what worked, what broke, and what I would do differently.</p>
      </a>
    </section>

    <!-- ALR Featured -->
    {alr && (
      <a href={`/projects/${alr.id}`} class="alr-section">
        <div class="alr-left">
          <span class="alr-title">All Language Resources</span>
          <span class="alr-dates">Built '16 &middot; Sold '21</span>
        </div>
        <div class="alr-right">
          <p class="alr-description">I started All Language Resources in a Beijing apartment while teaching, reviewing language-learning apps and courses. It grew to 100,000 monthly visitors with six regular contributors and affiliate systems I built and ran. I sold it in 2021 for $960,000, and the site is still live today.</p>
        </div>
      </a>
    )}

    <!-- The Winding Road -->
    <section class="archive-section">
      <span class="archive-label">The winding road</span>
      <div class="archive-list">
        {timelineProjects.map(project => (
          <a href={`/projects/${project.id}`} class="archive-row">
            <div class="archive-bar"></div>
            <span class="archive-name">{project.data.title}</span>
            <span class="archive-desc">{project.data.tagline}</span>
            <span class="archive-year">{shortenYear(project.data.year)}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Latest writing -->
    {writingPosts.length > 0 && (
      <section class="archive-section writing-section">
        <span class="archive-label">Latest writing</span>
        <div class="archive-list">
          {writingPosts.map(post => (
            <a href={`/writing/${post.id}`} class="archive-row">
              <div class="archive-bar"></div>
              <span class="archive-name">{post.data.title}</span>
              <span class="archive-desc">{post.data.description}</span>
              <span class="archive-year">{formatPostDate(post.data.date)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Contact -->
    <section class="contact-section">
      <p class="contact-lead">If you're building something and need someone who can take it from idea to shipped, email me.</p>
      <div class="contact-links">
        <a href="mailto:ndahlhoff10@gmail.com" class="contact-link">ndahlhoff10@gmail.com</a>
        <span class="contact-sep">&middot;</span>
        <a href="https://twitter.com/lazyguac" class="contact-link" target="_blank" rel="noopener">@lazyguac</a>
        <span class="contact-sep">&middot;</span>
        <a href="https://www.linkedin.com/in/nick-dahlhoff-684860a3/" class="contact-link" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 1240px;
    margin: 0 auto;
    padding: 60px 100px;
    display: flex;
    flex-direction: column;
  }

  /* Hero */
  .hero {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: 72px;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-text);
  }

  .hero-sub {
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    line-height: 1.4;
    color: var(--color-accent-gold);
    max-width: 640px;
  }

  .hero-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    flex-shrink: 0;
    padding-top: 8px;
    max-width: 280px;
    text-align: right;
  }

  .looking-for-link {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    color: var(--color-accent-green);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .looking-for-link:hover {
    color: var(--color-accent-green-dark);
  }

  .hero-location {
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-text-muted);
  }

  /* Featured Cards */
  .current-grid {
    display: flex;
    gap: 24px;
    width: 100%;
    margin-top: 40px;
  }

  .current-card {
    flex: 1 1 0%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 32px;
    border: 1px solid var(--color-border);
    border-left: 5px solid var(--color-accent-green);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .current-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    text-decoration: none;
  }

  .current-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .current-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    line-height: 34px;
    color: var(--color-text);
    margin: 0;
  }

  .current-badge {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 14px;
    color: var(--color-accent-green-dark);
  }

  .current-tagline {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text-body);
  }

  /* ALR Section */
  .alr-section {
    display: flex;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    margin-top: 40px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .alr-section:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    text-decoration: none;
  }

  .alr-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-shrink: 0;
    width: 280px;
    padding: 32px 36px;
    gap: 8px;
    background: var(--color-accent-olive);
  }

  .alr-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-card-dark-text);
  }

  .alr-dates {
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-card-dark-subtle);
  }

  .alr-right {
    display: flex;
    align-items: center;
    flex-grow: 1;
    padding: 28px 40px;
    background: var(--color-olive-bg);
  }

  .alr-description {
    font-family: var(--font-serif);
    font-size: 17px;
    font-style: italic;
    line-height: 1.65;
    color: var(--color-text-overlay);
  }

  /* Archive / Timeline / Writing Section */
  .archive-section {
    display: flex;
    flex-direction: column;
    margin-top: 48px;
    width: 100%;
  }

  .archive-label {
    font-family: var(--font-serif);
    font-size: 15px;
    font-style: italic;
    line-height: 18px;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }

  .archive-list {
    display: flex;
    flex-direction: column;
  }

  .archive-row {
    display: grid;
    grid-template-columns: 84px 3px minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 16px;
    row-gap: 6px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }

  .archive-row:last-child {
    border-bottom: none;
  }

  .archive-row:hover {
    background: rgba(0,0,0,0.02);
    text-decoration: none;
  }

  .archive-bar {
    grid-column: 2;
    grid-row: 1 / 3;
    width: 3px;
    height: 100%;
    min-height: 32px;
    background: var(--color-text);
    border-radius: 2px;
  }

  .archive-name {
    grid-column: 3;
    grid-row: 1;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    line-height: 22px;
    color: var(--color-text);
    align-self: center;
  }

  .archive-desc {
    grid-column: 3;
    grid-row: 2;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-text-body);
  }

  .archive-year {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-text-muted);
  }

  /* Contact */
  .contact-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border);
  }

  .contact-lead {
    font-family: var(--font-serif);
    font-size: 20px;
    font-style: italic;
    line-height: 1.4;
    color: var(--color-text);
    max-width: 560px;
  }

  .contact-links {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .contact-link {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-accent-green);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .contact-link:hover {
    color: var(--color-accent-green-dark);
  }

  .contact-sep {
    color: var(--color-border);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .page {
      padding: 60px 40px;
    }

    .hero h1 {
      font-size: 52px;
    }
  }

  @media (max-width: 768px) {
    .page {
      padding: 40px 20px;
    }

    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .hero h1 {
      font-size: 40px;
    }

    .hero-right {
      align-items: flex-start;
      padding-top: 0;
      text-align: left;
      max-width: none;
    }

    .current-grid {
      flex-direction: column;
      margin-top: 32px;
    }

    .alr-section {
      flex-direction: column;
      margin-top: 32px;
    }

    .alr-left {
      width: 100%;
      padding: 24px 28px;
    }

    .alr-right {
      padding: 24px 28px;
    }

    .archive-section {
      margin-top: 36px;
    }

    .archive-row {
      grid-template-columns: 60px 3px minmax(0, 1fr);
      column-gap: 12px;
      padding: 14px 8px;
    }

    .contact-section {
      margin-top: 48px;
    }
  }
</style>
