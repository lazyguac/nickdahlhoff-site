---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
  latestUpdate,
  whereItStands,
  heroImage,
  heroAlt,
  heroCaption,
  sideImages,
  gallery,
  tech,
  skills,
  stage,
  year,
  url,
} = project.data;

const metaLine = stage ? `${year} · ${stage}` : year;
const externalUrl = Boolean(url && /^https?:\/\//.test(url));
const host = url ? url.replace(/^https?:\/\//, '').replace(/\/$/, '') : null;

// Updates are the build-log posts tagged with this project — publishing a post IS the update.
const allPosts = await getCollection('writing');
const projectPosts = allPosts
  .filter(p => !p.data.draft && p.data.project === project.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// "More things I've made": the next three in the homepage order, excluding this page.
const allProjects = await getCollection('projects');
const order = ['fantasy-joes', 'all-language-resources', 'hometown-coloring-book', 'recess', 'aura-finance', 'alpaca-college', 'manga-method', 'teaching', 'poker'];
const more = order
  .filter(slug => slug !== project.id)
  .map(slug => allProjects.find(p => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .slice(0, 3);

function postDate(d: Date): string {
  const mm = String(d.getUTCMonth() + 1).padStart(2, '0');
  const dd = String(d.getUTCDate()).padStart(2, '0');
  const yy = String(d.getUTCFullYear()).slice(-2);
  return `${mm}.${dd}.${yy}`;
}
---

<BaseLayout title={`${project.data.title} — Nick Dahlhoff`} description={project.data.tagline} noindex={project.data.noindex} section="made">
  <article class="project-page">
    <div class="container">

      <header class="project-header">
        <div class="header-text">
          <a href="/#made" class="back-link">&larr; Things I've made</a>
          <div class="project-meta">
            <span class="mono meta-line">{metaLine}</span>
            {host && <span class="mono meta-host">{host}</span>}
          </div>
          <h1>{project.data.title}</h1>
          <p class="project-tagline">{project.data.tagline}</p>
        </div>

        {latestUpdate ? (
          <div class="box header-box">
            <span class="mono box-label">Latest update · {latestUpdate.date}</span>
            <p class="box-text">{latestUpdate.summary}</p>
            {projectPosts.length > 0 && <a href="#updates" class="text-link box-link">All updates &darr;</a>}
          </div>
        ) : whereItStands ? (
          <div class="box header-box">
            <span class="mono box-label">Where it stands</span>
            <p class="box-text">{whereItStands}</p>
          </div>
        ) : null}
      </header>

      {heroImage && (
        <figure class:list={['hero-figure', { 'has-side': sideImages && sideImages.length > 0 }]}>
          <div class="hero-main frame">
            <img src={heroImage} alt={heroAlt ?? ''} />
          </div>
          {sideImages && sideImages.length > 0 && (
            <div class="hero-side">
              {sideImages.map(img => (
                <div class="frame side-frame"><img src={img.src} alt={img.alt} loading="lazy" /></div>
              ))}
            </div>
          )}
          {heroCaption && <figcaption class="cap">{heroCaption}</figcaption>}
        </figure>
      )}

      {gallery && gallery.length > 0 && (
        <section class="gallery">
          {gallery.map(item => (
            <figure class:list={['gallery-item', item.kind]}>
              <div class:list={['frame', { 'phone-frame': item.kind === 'phone' }]}>
                <img src={item.src} alt="" loading="lazy" />
              </div>
              <figcaption class="cap">{item.caption}</figcaption>
            </figure>
          ))}
        </section>
      )}

      <div class="project-body">
        <div class="project-content">
          <Content />
        </div>
        <aside class="project-aside">
          {skills && skills.length > 0 && (
            <div class="aside-block">
              <span class="mono aside-label">Skills</span>
              <div class="tag-list">{skills.map((s: string) => <span class="tag">{s}</span>)}</div>
            </div>
          )}
          {tech && tech.length > 0 && (
            <div class="aside-block">
              <span class="mono aside-label">Built with</span>
              <div class="tag-list">{tech.map((t: string) => <span class="tag">{t}</span>)}</div>
            </div>
          )}
          {url && externalUrl && (
            <a href={url} class="text-link aside-url" target="_blank" rel="noopener">{host} &rarr;</a>
          )}
          {url && !externalUrl && (
            <a href={url} class="text-link aside-url">{url} &rarr;</a>
          )}
        </aside>
      </div>

      {projectPosts.length > 0 && (
        <section class="project-updates" id="updates">
          <div class="updates-head">
            <h2>Updates on {project.data.title}</h2>
            <a href="/writing" class="mono updates-all">All updates &rarr;</a>
          </div>
          {projectPosts.map(post => (
            <a href={`/writing/${post.id}`} class="update-row">
              <span class="mono update-date">{postDate(post.data.date)}</span>
              <span class="update-text">
                <span class="update-title">{post.data.title}</span>
                <span class="update-desc">{post.data.description}</span>
              </span>
            </a>
          ))}
        </section>
      )}

      {more.length > 0 && (
        <section class="more">
          <span class="mono aside-label">More things I've made</span>
          <div class="more-grid">
            {more.map(p => (
              <a href={`/projects/${p.id}`} class="box more-card">
                {p.data.cardImage
                  ? <img src={p.data.cardImage} alt="" class="more-img" loading="lazy" />
                  : <div class="more-img more-tile">{p.id === 'poker' ? '♠' : p.id === 'teaching' ? '北京' : ''}</div>}
                <span class="more-text">
                  <span class="more-title">{p.data.title}</span>
                  <span class="mono more-meta">{p.data.stage ? `${p.data.year} · ${p.data.stage}` : p.data.year}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </article>
</BaseLayout>

<style>
  .project-page {
    padding-top: 56px;
  }
  .project-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 60px;
    align-items: end;
    padding-bottom: 32px;
  }
  .header-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .back-link {
    font-size: 13px;
    color: var(--color-text-muted);
  }
  .back-link:hover {
    color: var(--color-text);
  }
  .project-meta {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }
  .meta-line {
    color: var(--color-text-soft);
  }
  .meta-host {
    color: var(--color-text-muted);
  }
  .project-header h1 {
    font-size: 80px;
  }
  .project-tagline {
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-text-body);
    max-width: 820px;
  }
  .header-box {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px;
  }
  .box-label {
    font-size: 11px;
    color: var(--color-text-muted);
  }
  .box-text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-text);
  }
  .box-link {
    font-size: 13px;
  }

  /* Hero */
  .hero-figure {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px 24px;
    padding-top: 8px;
  }
  .hero-figure.has-side {
    grid-template-columns: minmax(0, 1fr) 380px;
  }
  .hero-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-side {
    display: grid;
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
  }
  .side-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .hero-figure figcaption {
    grid-column: 1 / -1;
  }
  .cap {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Gallery */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding-top: 48px;
    align-items: start;
  }
  .gallery-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .gallery-item.phone {
    max-width: 250px;
  }
  .phone-frame {
    border-radius: 28px;
    padding: 8px;
    background: #05070A;
  }
  .phone-frame img {
    border-radius: 22px;
  }

  /* Body */
  .project-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 80px;
    padding-top: 64px;
  }
  .project-content {
    max-width: 800px;
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-text-body);
  }
  .project-content :global(h2) {
    font-size: 28px;
    font-weight: 800;
    margin: 40px 0 16px;
  }
  .project-content :global(h2:first-child) {
    margin-top: 0;
  }
  .project-content :global(h3) {
    font-size: 20px;
    margin: 28px 0 10px;
  }
  .project-content :global(p) {
    margin-bottom: 18px;
  }
  .project-content :global(ul),
  .project-content :global(ol) {
    margin: 0 0 18px 22px;
  }
  .project-content :global(li) {
    margin-bottom: 10px;
  }
  .project-content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }
  .project-content :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .project-content :global(img),
  .project-content :global(video) {
    display: block;
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--color-line-strong);
    margin: 28px 0;
  }
  .project-aside {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .aside-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .aside-label {
    font-size: 11px;
    color: var(--color-text-muted);
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .aside-url {
    font-size: 14px;
    align-self: flex-start;
  }

  /* Updates */
  .project-updates {
    display: flex;
    flex-direction: column;
    padding-top: 64px;
    max-width: 1000px;
  }
  .updates-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-text-display);
  }
  .updates-head h2 {
    font-size: 32px;
    font-weight: 800;
  }
  .updates-all {
    letter-spacing: 0.12em;
  }
  .update-row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    column-gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line);
    color: inherit;
  }
  .update-row:last-child {
    border-bottom: none;
  }
  .update-row:hover {
    text-decoration: none;
    color: inherit;
  }
  .update-row:hover .update-title {
    color: var(--color-accent);
  }
  .update-date {
    color: var(--color-text-muted);
    text-transform: none;
    letter-spacing: 0.04em;
    padding-top: 4px;
  }
  .update-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .update-title {
    font-size: 19px;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }
  .update-desc {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-soft);
  }

  /* More */
  .more {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--color-line);
  }
  .more-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .more-card {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    padding: 12px;
    color: inherit;
  }
  .more-card:hover {
    text-decoration: none;
    color: inherit;
    border-color: var(--color-line-strong);
  }
  .more-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
    border-radius: 8px;
    display: block;
    background: var(--color-surface-2);
  }
  .more-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 800;
    color: var(--color-text-display);
  }
  .more-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .more-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text-display);
  }
  .more-meta {
    font-size: 11px;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .project-page {
      padding-top: 28px;
    }
    .project-header {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .project-header h1 {
      font-size: 44px;
    }
    .project-tagline {
      font-size: 17px;
    }
    .hero-figure.has-side {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-side {
      grid-template-rows: none;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .project-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding-top: 40px;
    }
    .update-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 6px;
    }
    .more-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
