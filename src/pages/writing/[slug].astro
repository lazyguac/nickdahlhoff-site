---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  // Draft posts are filtered out here too (not just on the index) so a draft never resolves at
  // a live URL, even if guessed or linked directly — a stricter rule than the index's filter.
  return posts
    .filter(p => !p.data.draft)
    .map(post => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatPostDate(d: Date): string {
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout title={`${post.data.title} — Nick Dahlhoff`} description={post.data.description}>
  <article class="post-page">
    <div class="container">
      <a href="/writing" class="back-link">&larr; Back to writing</a>

      <header class="post-header">
        <h1>{post.data.title}</h1>
        <span class="post-date">{formatPostDate(post.data.date)}</span>
      </header>

      <div class="post-content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-page {
    padding: var(--space-xl) 0 var(--space-3xl);
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .post-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .post-header h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-sm);
  }

  .post-date {
    font-size: 0.875rem;
    color: var(--color-text-light);
    font-weight: 500;
  }

  /* Markdown content styling — mirrors .project-content in projects/[slug].astro.
     Duplicated intentionally per spec §2.2 option (a): fast/pragmatic for a same-day ship,
     accept the duplication rather than extracting a shared prose.css partial. */
  .post-content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .post-content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .post-content :global(p) {
    margin-bottom: var(--space-md);
    color: var(--color-text);
    line-height: 1.75;
    max-width: 65ch;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
    max-width: 65ch;
  }

  .post-content :global(li) {
    margin-bottom: var(--space-sm);
    line-height: 1.6;
  }

  .post-content :global(strong) {
    font-weight: 600;
  }

  .post-content :global(img) {
    width: 100%;
    max-width: 720px;
    border-radius: 8px;
    background: var(--color-border);
    margin: var(--space-lg) 0;
    display: block;
    border: 1px solid var(--color-border);
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-xl) 0;
  }

  @media (max-width: 768px) {
    .post-header h1 {
      font-size: 1.75rem;
    }
  }
</style>
