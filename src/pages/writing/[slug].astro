---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  // Draft posts are filtered out here too (not just on the index) so a draft never resolves at
  // a live URL, even if guessed or linked directly — a stricter rule than the index's filter.
  return posts
    .filter(p => !p.data.draft)
    .map(post => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allProjects = await getCollection('projects');
const project = post.data.project ? allProjects.find(p => p.id === post.data.project) : undefined;

function formatPostDate(d: Date): string {
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout title={`${post.data.title} — Nick Dahlhoff`} description={post.data.description} section="updates">
  <article class="post-page">
    <div class="container post-container">
      <a href="/writing" class="back-link">&larr; All updates</a>
      <header class="post-header">
        <div class="post-meta">
          <span class="mono post-date">{formatPostDate(post.data.date)}</span>
          {project
            ? <a href={`/projects/${project.id}`} class="mono post-project">{project.data.title}</a>
            : <span class="mono post-project site">This site</span>}
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-desc">{post.data.description}</p>
      </header>
      <div class="post-content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-page {
    padding-top: 56px;
  }
  .post-container {
    max-width: 960px;
  }
  .back-link {
    display: inline-block;
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 28px;
  }
  .back-link:hover {
    color: var(--color-text);
  }
  .post-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 32px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--color-line);
  }
  .post-meta {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }
  .post-date {
    color: var(--color-text-muted);
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .post-project {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }
  .post-project.site {
    color: var(--color-text-muted);
  }
  .post-header h1 {
    font-size: 52px;
    line-height: 1.05;
  }
  .post-desc {
    font-size: 19px;
    line-height: 1.5;
    color: var(--color-text-body);
    max-width: 760px;
  }
  .post-content {
    font-size: 18px;
    line-height: 1.75;
    color: var(--color-text-body);
    max-width: 760px;
  }
  .post-content :global(h2) {
    font-size: 28px;
    font-weight: 800;
    margin: 40px 0 14px;
  }
  .post-content :global(h3) {
    font-size: 20px;
    margin: 28px 0 10px;
  }
  .post-content :global(p) {
    margin-bottom: 20px;
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 20px 22px;
  }
  .post-content :global(li) {
    margin-bottom: 8px;
  }
  .post-content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }
  .post-content :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-content :global(img) {
    display: block;
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--color-line-strong);
    margin: 28px 0;
  }
  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-line);
    margin: 32px 0;
  }
  .post-content :global(blockquote) {
    border-left: 2px solid var(--color-line-strong);
    padding-left: 18px;
    color: var(--color-text-soft);
    margin: 0 0 20px;
  }
  @media (max-width: 900px) {
    .post-page {
      padding-top: 28px;
    }
    .post-header h1 {
      font-size: 34px;
    }
    .post-content {
      font-size: 17px;
    }
  }
</style>
